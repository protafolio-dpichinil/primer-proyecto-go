// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/alpine
{
	"name": "Go Development",
	// Usamos una imagen pre-construida de Go para el desarrollo.
	// Esto es más rápido que construir desde un Dockerfile cada vez.
	"image": "mcr.microsoft.com/devcontainers/go:1.22",

	// Montamos el código fuente local en el workspaceFolder del contenedor.
	// Esto crea el "volumen" que mencionaste.
	"workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind,consistency=cached",

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// Reenviamos el puerto 8080 para poder acceder al microservicio desde el host.
	"forwardPorts": [8080],
	// Ejecuta 'go mod download' después de crear el contenedor para instalar dependencias.
	"postCreateCommand": "go mod download",

	// --- MÉTODO NO RECOMENDADO: Usar un archivo .env ---
	// Esto carga las variables de entorno desde un archivo .env en la raíz del proyecto.
	// También monta el archivo de clave de la cuenta de servicio referenciado en .env.
	// ADVERTENCIA: Esto es menos seguro que usar las credenciales del host.
	
	// Configuraciones específicas para VS Code dentro del contenedor.
    "customizations": {
        "vscode": {
            // Extensiones de VS Code que se instalarán automáticamente en el devcontainer.
            "extensions": [
                "golang.go", // La extensión oficial de Go.
                "GoogleCloudTools.cloudcode", // Extensión de Gemini Code Assist
                "yzhang.markdown-all-in-one"  // IntelliSense y herramientas para Markdown
            ],
            // Configuraciones del editor que se aplicarán en el contenedor.
            "settings": {
                "go.toolsManagement.autoUpdate": true,
                "go.useLanguageServer": true
            }
        }
    },
	// Establece el directorio de trabajo dentro del contenedor.
	// El código local se montará aquí.
	"workspaceFolder": "/app"
}
